generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["admin", "sales", "inventory", "customer"]
}

// ========================================================
// SCHEMA: ADMIN
// ========================================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String    @map("fullname") @db.VarChar(100)
  email        String?   @unique @db.VarChar(150)
  passwordHash String    @map("passwordhash") @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  dob          DateTime? @db.Date
  address      String?   @db.Text
  gender       String?   @db.VarChar(20)
  notes        String?   @db.Text
  role         String    @default("customer") @db.VarChar(20)
  status       String    @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime? @default(now()) @map("createdat") @db.Timestamp(6)
  lastLoginAt  DateTime? @map("lastloginat") @db.Timestamp(6)

  systemLogs     SystemLog[]
  promotions     Promotion[]
  orders         Order[]         @relation("UserOrders")
  assignedOrders Order[]         @relation("AssignedOrders")
  stockMovements StockMovement[]
  reviews        Review[]
  wishlists      Wishlist[]
  assignedLeads  Lead[]          @relation("AssignedLeads")
  cart           Cart?

  @@map("users")
  @@schema("admin")
}

model SystemLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId     String?   @map("staffid") @db.Uuid
  action      String    @db.VarChar(255)
  description String?   @db.Text
  createdAt   DateTime? @default(now()) @map("createdat") @db.Timestamp(6)

  staff User? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@map("system_logs")
  @@schema("admin")
}

model Promotion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique @db.VarChar(50)
  discountPercent Decimal?  @map("discountpercent") @db.Decimal(5, 2)
  validFrom       DateTime? @map("validfrom") @db.Timestamp(6)
  validUntil      DateTime? @map("validuntil") @db.Timestamp(6)
  createdBy       String?   @map("createdby") @db.Uuid

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("promotions")
  @@schema("admin")
}

model PermissionSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role        String   @unique @db.VarChar(50)
  permissions Json
  updatedAt   DateTime @default(now()) @updatedAt @map("updatedat") @db.Timestamp(6)

  @@map("permission_settings")
  @@schema("admin")
}

// ========================================================
// SCHEMA: SALES
// ========================================================

model Order {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?   @map("userid") @db.Uuid
  totalAmount     Decimal   @map("totalamount") @db.Decimal(15, 2)
  
  orderStatus     String    @default("PENDING") @map("orderstatus") @db.VarChar(50) 
  paymentStatus   String    @default("UNPAID") @map("paymentstatus") @db.VarChar(50) 
  
  paymentMethod   String?   @map("paymentmethod") @db.VarChar(50)
  transactionId   String?   @map("transactionid") @db.VarChar(100)
  
  cancelReason    String?   @map("cancelreason") @db.Text
  assignedStaffId String?   @map("assignedstaffid") @db.Uuid
  
  // Customer & Shipping Info
  fullName        String?   @map("fullname") @db.VarChar(100)
  phone           String?   @db.VarChar(20)
  shippingAddress String?   @map("shippingaddress") @db.Text

  createdAt       DateTime? @default(now()) @map("createdat") @db.Timestamp(6)
  updatedAt       DateTime? @updatedAt @map("updatedat") @db.Timestamp(6)

  user          User?       @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  assignedStaff User?       @relation("AssignedOrders", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]

  @@map("orders")
  @@schema("sales")
}

model OrderItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String  @map("orderid") @db.Uuid
  productName     String  @map("productname") @db.VarChar(255)
  selectedColor   String? @map("selectedcolor") @db.VarChar(50)
  selectedStorage String? @map("selectedstorage") @db.VarChar(50)
  price           Decimal @db.Decimal(15, 2)
  quantity        Int     @default(1)
  image           String? @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
  @@schema("sales")
}

model Cart {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @unique @map("userid") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime?  @default(now()) @map("createdat") @db.Timestamp(6)
  updatedAt DateTime?  @updatedAt @map("updatedat") @db.Timestamp(6)

  @@map("carts")
  @@schema("sales")
}

model CartItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId          String   @map("cartid") @db.Uuid
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String?  @map("productid") @db.VarChar(255)
  productName     String   @map("productname") @db.VarChar(255)
  selectedColor   String?  @map("selectedcolor") @db.VarChar(50)
  selectedStorage String?  @map("selectedstorage") @db.VarChar(50)
  price           Decimal  @db.Decimal(15, 2)
  quantity        Int      @default(1)
  image           String?  @db.Text
  createdAt       DateTime? @default(now()) @map("createdat") @db.Timestamp(6)

  @@map("cart_items")
  @@schema("sales")
}

model CustomerContact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String?   @map("fullname") @db.VarChar(100)
  phone           String?   @db.VarChar(20)
  email           String?   @db.VarChar(150)
  productInterest String?   @map("productinterest") @db.VarChar(255)
  notes           String?   @db.Text
  createdAt       DateTime? @default(now()) @map("createdat") @db.Timestamp(6)

  @@map("customer_contacts")
  @@schema("sales")
}

enum Temperature {
  HOT
  WARM
  COLD

  @@schema("sales")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST

  @@schema("sales")
}

model Lead {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String         @db.VarChar(150)
  email           String         @db.VarChar(150)
  phone           String?        @db.VarChar(20)
  productInterest String         @map("productinterest") @db.VarChar(255)
  budgetRange     String?        @map("budgetrange") @db.VarChar(50)
  source          String         @db.VarChar(50)
  score           Int            @default(0)
  temperature     Temperature    @default(COLD)
  status          LeadStatus     @default(NEW)
  assignedToId    String?        @map("assignedtoid") @db.Uuid
  assignedTo      User?          @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities      LeadActivity[]
  createdAt       DateTime?      @default(now()) @map("createdat") @db.Timestamp(6)
  updatedAt       DateTime?      @updatedAt @map("updatedat") @db.Timestamp(6)

  @@map("leads")
  @@schema("sales")
}

model LeadActivity {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId       String    @map("leadid") @db.Uuid
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activityType String    @map("activitytype") @db.VarChar(50)
  scoreDelta   Int       @map("scoredelta")
  metadata     Json?
  createdAt    DateTime? @default(now()) @map("createdat") @db.Timestamp(6)

  @@map("lead_activities")
  @@schema("sales")
}


// ========================================================
// SCHEMA: INVENTORY
// ========================================================

model Product {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String  @db.VarChar(255)
  category      String? @db.VarChar(100)
  basePrice     Decimal @map("baseprice") @db.Decimal(15, 2)
  heroImage     String? @map("heroimage") @db.Text
  description   String? @db.Text
  highlights    Json?
  specs         Json?
  camera        Json?
  performance   Json?
  design        Json?
  edition       String? @db.VarChar(100)
  watermarkText String? @map("watermarktext") @db.VarChar(50)

  variants  ProductVariant[]
  reviews   Review[]
  wishlists Wishlist[]

  @@map("products")
  @@schema("inventory")
}

model ProductVariant {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String  @map("productid") @db.Uuid
  color         String? @db.VarChar(50)
  storage       String? @db.VarChar(50)
  price         Decimal @db.Decimal(15, 2)
  stockQuantity Int     @default(0) @map("stockquantity")
  image         String? @db.Text

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@map("product_variants")
  @@schema("inventory")
}

model StockMovement {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId        String    @map("variantid") @db.Uuid
  changeType       String    @map("changetype") @db.VarChar(20)
  quantity         Int
  notes            String?   @db.Text
  createdByStaffId String?   @map("createdbystaffid") @db.Uuid
  createdAt        DateTime? @default(now()) @map("createdat") @db.Timestamp(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  staff   User?          @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@map("stock_movements")
  @@schema("inventory")
}

// ========================================================
// SCHEMA: CUSTOMER
// ========================================================

model Review {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("userid") @db.Uuid
  productId String    @map("productid") @db.Uuid
  rating    Int?
  comment   String?   @db.Text
  createdAt DateTime? @default(now()) @map("createdat") @db.Timestamp(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
  @@schema("customer")
}

model Wishlist {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("userid") @db.Uuid
  productId String    @map("productid") @db.Uuid
  createdAt DateTime? @default(now()) @map("createdat") @db.Timestamp(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
  @@schema("customer")
}
